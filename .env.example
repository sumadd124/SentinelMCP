# Server Configuration
PORT=3000
HOST=127.0.0.1
NODE_ENV=development
LOG_LEVEL=info

# HMAC-SHA256 Token Signing Secret (Minimum 32 bytes)
CAPABILITY_SECRET=replace_with_64_character_hex_secret_generated_via_crypto

# AWS Bedrock Guardrails (Leave BEDROCK_ENABLED=false for deterministic local demo mode)
BEDROCK_ENABLED=false
AWS_REGION=us-east-1
BEDROCK_GUARDRAIL_ID=
BEDROCK_GUARDRAIL_VERSION=DRAFT

# Database
DATABASE_PATH=./data/sentinelmcp.db