{
  "name": "sentinelmcp",
  "version": "1.0.0",
  "description": "Enterprise Security Gateway & Transaction Monitor for Model Context Protocol",
  "type": "module",
  "bin": {
    "sentinelmcp": "./dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build:gateway": "tsc -p tsconfig.json",
    "build:dashboard": "npm run build --workspace=dashboard",
    "build": "npm run build:gateway && npm run build:dashboard",
    "dev:gateway": "tsx watch src/index.ts",
    "dev:dashboard": "npm run dev --workspace=dashboard",
    "dev": "concurrently -n \"gateway,dashboard\" -c \"blue.bold,magenta.bold\" \"npm run dev:gateway\" \"npm run dev:dashboard\"",
    "stdio": "tsx src/transports/stdio-runner.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "start": "node dist/cli.js"
  },
  "dependencies": {
    "@aws-sdk/client-bedrock-runtime": "^3.1155.0",
    "@fastify/cors": "^10.0.2",
    "@libsql/client": "^0.14.0",
    "@modelcontextprotocol/sdk": "^1.6.1",
    "dotenv": "^18.0.8",
    "fastify": "^5.2.1",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/dotenv": "^6.1.1",
    "@types/node": "^22.13.9",
    "concurrently": "^9.1.2",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2",
    "vitest": "^3.0.7"
  }
}